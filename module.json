{
  "id": "animater",
  "title": "Animater",
  "description": "Automatic JB2A animations (Free or Patreon, install one) with Sequencer for PF2e, SF2e, D&D 5e and Daggerheart.",
  "version": "4.7.4",
  "authors": [
    {
      "name": "Animater contributors"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/animater.css"
  ],
  "relationships": {
    "requires": [
      {
        "id": "sequencer",
        "type": "module",
        "compatibility": {
          "minimum": "4.2"
        },
        "manifest": "https://github.com/fantasycalendar/FoundryVTT-Sequencer/releases/latest/download/module.json"
      }
    ]
  },
  "socket": true,
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#"
}
